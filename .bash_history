ansible-playbook -i /home/egregg/ansible/week5/hosts site.yml
cat << 'EOF' > /home/egregg/ansible/week5/playbooks/roles/google_chrome/tasks/main.yml
---
- name: Remove the broken google-chrome repository file if present
  ansible.builtin.file:
    path: /etc/yum.repos.d/google-chrome.repo
    state: absent

- name: Force install Google Chrome directly via DNF command
  ansible.builtin.command:
    cmd: dnf install -y https://google.com
  register: dnf_result
  changed_when: "'Installing' in dnf_result.stdout or 'Upgrading' in dnf_result.stdout"
EOF

