cat << 'EOF' > /home/egregg/ansible/week5/playbooks/roles/google_chrome/tasks/main.yml
---
- name: Remove the broken google-chrome repository file if present
  ansible.builtin.file:
    path: /etc/yum.repos.d/google-chrome.repo
