- name: Install PHP and required WordPress extensions
  ansible.builtin.dnf:
    name:
      - php
      - php-mysqlnd
      - php-fpm
      - php-json
    state: present

- name: Restart Apache to load new PHP modules
  ansible.builtin.systemd:
    name: httpd
    state: restarted
EOF

