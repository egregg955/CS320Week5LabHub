cd ansible/
cd week5/
TASK_DIR="playbooks/roles/mariadb/tasks"
FILE_DIR="playbooks/roles/mariadb/files/html"
mkdir -p "$TASK_DIR" "$FILE_DIR"
cat << 'EOF' > "$TASK_DIR/main.yml"
---
- name: Install MariaDB server package
  ansible.builtin.dnf:
    name: mariadb-server
    state: present

- name: Ensure MariaDB service is enabled and started
  ansible.builtin.systemd:
    name: mariadb
    state: started
    enabled: true

- name: Confirm MariaDB service is active
  ansible.builtin.systemd:
    name: mariadb
  register: mariadb_status
  failed_when: mariadb_status.status.ActiveState != "active"
  changed_when: false
EOF

